{
  "name": "@fuck-shorts/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "drizzle-kit": "drizzle-kit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "prettier": "@fuck-shorts/prettier-config",
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@fuck-shorts/eslint-config": "workspace:*",
    "@fuck-shorts/prettier-config": "workspace:*",
    "@fuck-shorts/tsconfig": "workspace:*",
    "@types/node": "^22.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}

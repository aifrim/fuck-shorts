# Local monorepo env (single source of truth). Copy to `.env` and adjust.
# Website (Astro) loads PUBLIC_* via vite.envDir → this file.
# Worker bindings (D1 DB, PETITION_START, cache TTL) come from apps/website/wrangler.jsonc.

# Absolute origin for og:image meta (defaults to https://fuckshorts.com if unset).
PUBLIC_SITE_ORIGIN=http://localhost:4325
# UTC midnight on Sunday 6 Sep 2026 (03:00 in UTC+3). Used for SSG/SSR gate at build/request time.
# Keep identical to PETITION_START in wrangler.jsonc.
PUBLIC_PETITION_START=2026-09-06T00:00:00.000Z
# Optional ISO end; omit for no close date. Keep identical to PETITION_END in wrangler when set.
# PUBLIC_PETITION_END=2027-01-01T00:00:00.000Z

# Optional build-time Cache-Control for public/_headers (see pnpm headers).
# ASTRO_ASSET_CACHE_CONTROL=public, max-age=31536000, immutable
# HTML_CACHE_CONTROL=public, max-age=86400, must-revalidate

# Local monorepo env (single source of truth). Copy to `.env` and adjust.
# Website (Astro) loads PUBLIC_* via vite.envDir → this file.
# Server routes also load this file for LIBSQL_* / PETITION_START / cache TTL.

LIBSQL_DB_URL=file:.data/local.db
# Absolute origin for og:image meta (defaults to https://fuckshorts.com if unset).
PUBLIC_SITE_ORIGIN=http://localhost:4325
# UTC midnight on Sunday 6 Sep 2026 (03:00 in UTC+3). Keep these two identical.
PUBLIC_PETITION_START=2026-09-06T00:00:00.000Z
PETITION_START=2026-09-06T00:00:00.000Z
# GET /api/votes + /og.png cache TTL (seconds). Use 60 locally; omit or 3600 in production.
VOTES_CACHE_TTL_SECONDS=60

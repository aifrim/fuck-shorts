{
  "name": "@fuck-shorts/website-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:before-start": "playwright test --project=before-start",
    "test:open": "playwright test --project=open",
    "test:ended": "playwright test --project=ended",
    "test:share": "playwright test --project=open tests/share-sheet.spec.ts",
    "test:ui": "playwright test --ui",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "prettier": "@fuck-shorts/prettier-config",
  "devDependencies": {
    "@fuck-shorts/eslint-config": "workspace:*",
    "@fuck-shorts/prettier-config": "workspace:*",
    "@fuck-shorts/tsconfig": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
